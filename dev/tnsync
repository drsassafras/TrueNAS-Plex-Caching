#!/usr/bin/env bash
#
# tnsync — copy a project's code to a TrueNAS app and (optionally) restart it.
#
#   tnsync local     the files in your folder right now, uncommitted changes included
#   tnsync master    the latest code on GitHub's default branch (main or master)
#   tnsync dev       the latest code on GitHub's dev branch
#   tnsync release   the newest release tag, e.g. v1.2.0
#   tnsync beta      the newest tag including pre-releases, e.g. v1.3.0-beta.1
#   tnsync init      set up tnsync for the project you're in
#
# Options:
#   -n, --dry-run    show what would be copied and run the tests; change nothing
#   -y, --yes        restart the app afterwards without asking
#   -N, --no-restart don't restart (and don't ask)
#   --tests-first    run the tests BEFORE copying, and copy nothing unless they pass
#   --skip-tests     don't run the project's tests at all
#   --skip-future    run the current tests only, not the future ones (TN_FUTURE)
#   -h, --help       this help
#
# If the project's .tnsync has TN_TEST, that command runs in the code being
# copied: by default after the copy and restart (so the app is ready sooner),
# or first with --tests-first. With TN_FUTURE too (the suite on the next
# Python, say), that runs straight after — only once the current tests pass.
# The run ends in one big box: green when every test run passed, red when
# the current tests failed, green above and red below when only the future
# ones did — each run (current, future) on its own line.
# TNSYNC_MODE (local, master, dev, release, beta) tells the tests which was asked for.
#
# If the NAS already has exactly these files, nothing is copied or restarted.
# When the last tests tnsync ran there passed, it just says so (green banner);
# otherwise it runs the tests again (yellow banner first).
#
# Settings come from two files (KEY=value lines):
#   ~/.config/tnsync/config   shared:      TN_HOST, TN_USER, TN_PORT
#   <project>/.tnsync         per project: TN_APP, TN_DEST, TN_PATHS, TN_EXCLUDE, TN_TEST, TN_FUTURE
#                              (and may override any shared setting)
#
# Written for the bash 3.2 that ships with macOS.

set -eo pipefail

TNSYNC_VERSION="1.5.0"
GLOBAL_CONF="${TNSYNC_CONFIG:-$HOME/.config/tnsync/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tnsync"   # last test result per app

# ----------------------------------------------------------------- output
if [ -t 1 ]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_BLU=$'\033[34m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
    C_BAD=$'\033[1;97;41m'   # bold white on red
    C_GOOD=$'\033[1;97;42m'  # bold white on green
    C_MEH=$'\033[1;30;43m'   # bold black on yellow
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_DIM=""; C_OFF=""; C_BAD=""; C_GOOD=""; C_MEH=""
fi
say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$C_BLU" "$C_OFF" "$*"; }
ok()   { printf '%s✔%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%sWarning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
die()  { printf '%stnsync:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

usage() {
    sed -n '3,38p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Loud blocks that can't be missed in the terminal.
banner() {   # banner <colour> <line>...
    local colour="$1" line
    shift
    printf '\n'
    for line in "" "$@" ""; do
        printf '%s  %-66s  %s\n' "$colour" "$line" "$C_OFF"
    done
    printf '\n'
}
red_banner()    { banner "$C_BAD" "$@" >&2; }
split_banner() {   # split_banner <green line>... -- <red line>...: one box, green above the separator, red below it
    local line colour="$C_GOOD"
    printf '\n'
    printf '%s  %-66s  %s\n' "$colour" "" "$C_OFF"
    for line in "$@"; do
        if [ "$line" = "--" ]; then colour="$C_BAD"; continue; fi
        printf '%s  %-66s  %s\n' "$colour" "$line" "$C_OFF"
    done
    printf '%s  %-66s  %s\n' "$colour" "" "$C_OFF"
    printf '\n'
}
green_banner()  { banner "$C_GOOD" "$@"; }
yellow_banner() { banner "$C_MEH" "$@"; }
fail() { red_banner "$@"; exit 1; }   # a red block, then stop

# ----------------------------------------------------------------- args
MODE=""
DRY_RUN=0
RESTART="ask"   # ask | yes | no
SKIP_TESTS=0
SKIP_FUTURE=0
TESTS_FIRST=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run)    DRY_RUN=1 ;;
        -y|--yes)        RESTART="yes" ;;
        -N|--no-restart) RESTART="no" ;;
        --skip-tests)    SKIP_TESTS=1 ;;
        --skip-future)   SKIP_FUTURE=1 ;;
        --tests-first)   TESTS_FIRST=1 ;;
        -h|--help)       usage 0 ;;
        --version)       say "tnsync $TNSYNC_VERSION"; exit 0 ;;
        -*)              die "unknown option: $1 (see tnsync --help)" ;;
        *)
            [ -z "$MODE" ] || die "only one of local, master, dev, release, beta or init"
            MODE="$1" ;;
    esac
    shift
done
case "$MODE" in
    local|master|main|dev|release|beta|init) ;;
    "") usage 1 ;;
    *)  die "unknown command: $MODE (use local, master, dev, release, beta or init)" ;;
esac

# ----------------------------------------------------------------- config
TN_HOST=""; TN_USER="truenas_admin"; TN_PORT="22"
TN_APP=""; TN_DEST=""; TN_PATHS="."; TN_EXCLUDE=".git .DS_Store __pycache__ *.pyc"; TN_TEST=""; TN_FUTURE=""

# Read KEY=value lines. The file is parsed, never executed.
load_conf() {
    local file="$1" line key val n=0
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%%#*}"                                   # strip comments
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        case "$line" in
            *=*) ;;
            *) warn "$file line $n ignored: $line"; continue ;;
        esac
        key="${line%%=*}"; val="${line#*=}"
        case "$val" in                                       # strip one pair of quotes
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        case "$key" in
            TN_HOST|TN_USER|TN_PORT|TN_APP|TN_DEST|TN_PATHS|TN_EXCLUDE|TN_TEST|TN_FUTURE) printf -v "$key" '%s' "$val" ;;
            *) warn "$file line $n: unknown setting $key" ;;
        esac
    done < "$file"
}

find_project_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ] && [ -n "$dir" ]; do
        if [ -f "$dir/.tnsync" ]; then printf '%s' "$dir"; return 0; fi
        dir="$(dirname "$dir")"
    done
    return 1
}

# ----------------------------------------------------------------- init
do_init() {
    local root ans
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
    if [ ! -f "$GLOBAL_CONF" ]; then
        info "Shared settings ($GLOBAL_CONF)"
        read -r -p "  TrueNAS address (e.g. 192.168.1.10): " ans
        [ -n "$ans" ] || die "an address is needed"
        local host="$ans"
        read -r -p "  SSH user on TrueNAS [truenas_admin]: " ans
        local user="${ans:-truenas_admin}"
        mkdir -p "$(dirname "$GLOBAL_CONF")"
        printf '# tnsync shared settings\nTN_HOST=%s\nTN_USER=%s\nTN_PORT=22\n' "$host" "$user" > "$GLOBAL_CONF"
        ok "wrote $GLOBAL_CONF"
    fi
    if [ -f "$root/.tnsync" ]; then
        ok "$root/.tnsync already exists"
        return 0
    fi
    info "Project settings ($root/.tnsync)"
    read -r -p "  TrueNAS app name to restart (e.g. myapp-dev): " ans
    local app="$ans"
    read -r -p "  Folder on TrueNAS to copy into (e.g. /mnt/tank/apps/$app/src): " ans
    local dest="$ans"
    read -r -p "  What to copy from this project [.]: " ans
    local paths="${ans:-.}"
    cat > "$root/.tnsync" <<EOF
# tnsync settings for this project. See: tnsync --help
TN_APP=$app
TN_DEST=$dest
# Folders/files in this project to copy, separated by spaces ("." = everything).
TN_PATHS=$paths
# Patterns never copied.
TN_EXCLUDE=.git .DS_Store __pycache__ *.pyc
# Command that must pass before anything is copied (run in the project folder).
# e.g. TN_TEST=python3 -m unittest   or   TN_TEST=npm test
TN_TEST=
# A second test run, only once TN_TEST passes: the suite on the next Python, say.
# e.g. TN_FUTURE=python3 dev/future.py
TN_FUTURE=
EOF
    ok "wrote $root/.tnsync"
}

if [ "$MODE" = "init" ]; then
    do_init
    exit 0
fi

ROOT="$(find_project_root)" || die "no .tnsync file here or in any parent folder. Run 'tnsync init' in your project first."
load_conf "$GLOBAL_CONF"
load_conf "$ROOT/.tnsync"

[ -n "$TN_HOST" ] || die "TN_HOST isn't set. Put it in $GLOBAL_CONF (or run 'tnsync init')."
[ -n "$TN_APP" ]  || die "TN_APP isn't set in $ROOT/.tnsync"
[ -n "$TN_DEST" ] || die "TN_DEST isn't set in $ROOT/.tnsync"
[[ "$TN_APP" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "TN_APP '$TN_APP' doesn't look like a TrueNAS app name"
[[ "$TN_DEST" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "TN_DEST must be an absolute path without spaces: '$TN_DEST'"
[ "$TN_DEST" != "/" ] || die "TN_DEST can't be /"
[[ "$TN_PORT" =~ ^[0-9]+$ ]] || die "TN_PORT must be a number"

# ----------------------------------------------------------------- source
TMP=""
SSH_CTL="/tmp/tnsync-$(id -u)-%C"
cleanup() {
    if [ -n "$TMP" ]; then rm -rf "$TMP"; fi
    ssh -o ControlPath="$SSH_CTL" -O exit -p "$TN_PORT" "$TN_USER@$TN_HOST" >/dev/null 2>&1 || true
}
trap cleanup EXIT

export_ref() {   # export_ref <ref> <label>
    local ref="$1"
    git -C "$ROOT" rev-parse --verify --quiet "$ref^{commit}" >/dev/null || die "can't find $ref in this repository"
    TMP="$(mktemp -d "${TMPDIR:-/tmp}/tnsync.XXXXXX")"
    git -C "$ROOT" archive "$ref" | tar -x -C "$TMP"
    SRC="$TMP"
    SRC_LABEL="$2 ($(git -C "$ROOT" rev-parse --short "$ref^{commit}"))"
}

newest_tag() {   # newest_tag <regex>
    # versionsort.suffix=- makes 1.0.0-beta.1 sort before 1.0.0
    git -C "$ROOT" -c versionsort.suffix=- tag -l --sort=-v:refname | grep -E "$1" | head -n 1 || true
}

case "$MODE" in
    local)
        SRC="$ROOT"
        SRC_LABEL="your folder as it is now"
        if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
            if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
                SRC_LABEL="$SRC_LABEL, including uncommitted changes"
            fi
            SRC_LABEL="$SRC_LABEL (on $(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null))"
        fi
        ;;
    master|main|dev|release|beta)
        git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "'tnsync $MODE' needs a git repository; use 'tnsync local'"
        info "Fetching from GitHub…"
        git -C "$ROOT" fetch --quiet --tags origin || fail "CAN'T REACH GITHUB  -  NOTHING WAS COPIED" \
            "" \
            "git fetch failed (see the error above)." \
            "Check that you're online, then run 'tnsync $MODE' again."
        if [ "$MODE" = "master" ] || [ "$MODE" = "main" ]; then
            ref="$(git -C "$ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
            if [ -z "$ref" ]; then
                git -C "$ROOT" remote set-head origin --auto >/dev/null 2>&1 || true
                ref="$(git -C "$ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
            fi
            if [ -z "$ref" ]; then
                for b in main master; do
                    if git -C "$ROOT" rev-parse --verify --quiet "origin/$b" >/dev/null; then ref="origin/$b"; break; fi
                done
            fi
            [ -n "$ref" ] || die "can't work out the default branch on origin"
            export_ref "$ref" "$ref"
        elif [ "$MODE" = "dev" ]; then
            git -C "$ROOT" rev-parse --verify --quiet "origin/dev" >/dev/null || die "there's no dev branch on origin"
            export_ref "origin/dev" "origin/dev"
        elif [ "$MODE" = "release" ]; then
            tag="$(newest_tag '^v?[0-9]+(\.[0-9]+)*$')"
            [ -n "$tag" ] || die "no release tags (like v1.2.0) yet"
            export_ref "$tag" "release $tag"
        else
            tag="$(newest_tag '^v?[0-9]+(\.[0-9]+)*(-.+)?$')"
            [ -n "$tag" ] || die "no version tags (like v1.3.0-beta.1) yet"
            export_ref "$tag" "beta channel $tag"
        fi
        ;;
esac

# ----------------------------------------------------------------- copy
REMOTE="$TN_USER@$TN_HOST"
SSH_OPTS="-o ControlMaster=auto -o ControlPath=$SSH_CTL -o ControlPersist=120 -p $TN_PORT"
ssh_run() { ssh $SSH_OPTS "$REMOTE" "$@"; }

say ""
say "  ${C_DIM}Project${C_OFF}  $ROOT"
say "  ${C_DIM}Source${C_OFF}   $SRC_LABEL"
say "  ${C_DIM}To${C_OFF}       $REMOTE:$TN_DEST"
say "  ${C_DIM}App${C_OFF}      $TN_APP"
[ "$DRY_RUN" = 1 ] && say "  ${C_YEL}Dry run: nothing will be changed${C_OFF}"
say ""

# ----------------------------------------------------------------- last test result
# One small file per NAS folder, written only when the tests ran on exactly the
# code that's on the NAS. Read as KEY=value lines, never run.
STATE_FILE="$STATE_DIR/$(printf '%s' "$TN_HOST:$TN_DEST" | tr -c 'A-Za-z0-9._-' '_')"
state_get() { [ -f "$STATE_FILE" ] && sed -n "s/^$1=//p" "$STATE_FILE" | head -n 1; true; }
state_clear() { rm -f "$STATE_FILE"; }
record_tests() {   # record_tests pass|fail — only if the tests actually ran
    if [ "$TESTS_RAN" != 1 ]; then state_clear; return 0; fi
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf 'result=%s\nmode=%s\nwhen=%s\ntest=%s\nfuture=%s\nfuture_test=%s\n' "$1" "$MODE" "$(date '+%Y-%m-%d %H:%M')" "$TN_TEST" "$FUTURE_RESULT" "$FUTURE_CMD" \
        > "$STATE_FILE" 2>/dev/null || true
}
# The future tests asked for this run: TN_FUTURE, or nothing with --skip-future (or no tests at all).
FUTURE_CMD=""
[ "$SKIP_TESTS" = 1 ] || [ "$SKIP_FUTURE" = 1 ] || FUTURE_CMD="$TN_FUTURE"
# Prints why the last result doesn't count for this run; prints nothing if it passed.
last_tests_not_passed() {
    local result when
    result="$(state_get result)"; when="$(state_get when)"
    if [ -z "$result" ]; then
        say "tnsync has no test result for this code yet."
    elif [ "$result" != "pass" ]; then
        say "The last test run failed ($when)."
    elif [ "$(state_get test)" != "$TN_TEST" ]; then
        say "TN_TEST has changed since the last test run."
    elif [ "$(state_get mode)" != "$MODE" ]; then
        say "The last tests ran for 'tnsync $(state_get mode)', not 'tnsync $MODE'."
    elif [ "$(state_get future_test)" != "$FUTURE_CMD" ]; then
        say "TN_FUTURE has changed since the last test run."
    fi
}

# ----------------------------------------------------------------- tests
# run_tests before|after|insync — runs TN_TEST in the code being copied, then
# TN_FUTURE once it passes. Ends in one big box: green when every run passed,
# red when the current tests failed, green over red when only the future ones
# did (each run on its own line, and what that means for the NAS). Returns
# non-zero when a run failed. Sets TESTS_RAN=1 if it ran them.
TESTS_RAN=0
FUTURE_RESULT="none"   # pass | fail | none — what the state file keeps of the future tests
run_in_src() {   # run_in_src <command> — in the code being copied (for master/dev/release/beta
    # that's the exported copy, not your folder). Python's bytecode cache is kept out of the
    # project. Straight to the terminal (not through a pipe), so a test runner can draw a progress bar.
    ( cd "$SRC" && TNSYNC_MODE="$MODE" PYTHONDONTWRITEBYTECODE=1 bash -c "$1" )
}
run_tests() {
    local when="$1" current future future_cmd title
    if [ "$SKIP_TESTS" = 1 ]; then
        warn "--skip-tests: the tests weren't run"
        return 0
    fi
    if [ -z "$TN_TEST" ]; then
        say "  ${C_DIM}No TN_TEST in .tnsync, so no tests were run.${C_OFF}"
        return 0
    fi
    info "Running the current tests: $TN_TEST"
    TESTS_RAN=1
    if run_in_src "$TN_TEST"; then
        ok "Current tests passed"
        current="passed"
    else
        current="FAILED"
    fi
    FUTURE_RESULT="none"
    future_cmd=""   # (shown beside the result only when they ran)
    if [ -z "$TN_FUTURE" ]; then
        future="not set up (TN_FUTURE in .tnsync)"
    elif [ "$SKIP_FUTURE" = 1 ]; then
        future="not run (--skip-future)"
    elif [ "$current" != "passed" ]; then
        future="not run: the current tests failed"
    else
        future_cmd="$TN_FUTURE"
        info "Running the future tests: $TN_FUTURE"
        if run_in_src "$TN_FUTURE"; then
            ok "Future tests passed"
            future="passed"; FUTURE_RESULT="pass"
        else
            future="FAILED"; FUTURE_RESULT="fail"
        fi
    fi
    # The one box that says it all: both runs, then where that leaves the NAS.
    if [ "$current" = "passed" ] && [ "$future" != "FAILED" ]; then
        green_banner "ALL TESTS PASSED" \
                     "" \
                     "$(printf 'Current  %-10s %s' "$current" "$TN_TEST")" \
                     "$(printf 'Future   %-10s %s' "$future" "$future_cmd")"
        return 0
    fi
    # what that leaves: the title's tail, and the lines under the two runs
    local tail="" after=()
    if [ "$when" = "insync" ]; then
        tail="  -  THE FILES WERE ALREADY IN SYNC"
        after=("$TN_APP is running this code (nothing was copied)." "Fix the failures above, then run 'tnsync $MODE' again.")
    elif [ "$when" = "before" ]; then
        tail="  -  NOTHING WAS COPIED TO $TN_HOST"
        after=("$TN_APP is still running the code it had before." "Fix the failures above, then run 'tnsync $MODE' again.")
    elif [ "$DRY_RUN" = 1 ]; then
        tail="  (dry run: nothing was copied)"
    else
        tail="  -  BUT THE CODE IS ALREADY ON $TN_HOST"
        after=("$TN_APP has this code$( [ "$RESTART" = "yes" ] && printf ' and was restarted' )." \
               "Fix the failures above, then run 'tnsync $MODE' again." "(--tests-first copies only code whose tests pass.)")
    fi
    [ "${#after[@]}" -gt 0 ] && after=("" "${after[@]}")
    if [ "$current" = "passed" ]; then
        # the current tests passed and the future ones didn't: green over red, so a glance says which half is which
        split_banner "CURRENT TESTS PASSED" \
                     "$(printf 'Current  %-10s %s' "$current" "$TN_TEST")" \
                     -- \
                     "FUTURE TESTS FAILED$tail" \
                     "$(printf 'Future   %-10s %s' "$future" "$future_cmd")" \
                     "${after[@]}" >&2
    else
        red_banner "CURRENT TESTS FAILED$tail" \
                   "" \
                   "$(printf 'Current  %-10s %s' "$current" "$TN_TEST")" \
                   "$(printf 'Future   %-10s %s' "$future" "$future_cmd")" \
                   "${after[@]}"
    fi
    return 1
}

command -v rsync >/dev/null 2>&1 || die "rsync isn't installed (on a Mac: it normally is; try 'brew install rsync')"
info "Connecting to ${TN_HOST}…"
ssh_run "true" || fail "CAN'T CONNECT TO $TN_HOST  -  NOTHING WAS COPIED" \
    "" \
    "SSH to $REMOTE failed (see the error above). Check:" \
    "  - you're online and on the same network as the NAS" \
    "  - TrueNAS: System > Services > SSH is running" \
    "  - your key is added to $TN_USER"

set -f   # keep exclude patterns like *.pyc from expanding here
RSYNC_BASE=(-a --delete -e "ssh $SSH_OPTS")
for pat in $TN_EXCLUDE; do RSYNC_BASE+=(--exclude "$pat"); done
RSYNC_ARGS=("${RSYNC_BASE[@]}")
[ "$DRY_RUN" = 1 ] && RSYNC_ARGS+=(-n -v) || RSYNC_ARGS+=(-v)
PATHS_LIST=$TN_PATHS
set +f

resolve_path() {   # resolve_path <TN_PATHS entry> — sets from, to, parent
    local p="$1"
    case "$p" in ..*|/*) die "TN_PATHS entries must be inside the project: $p" ;; esac
    if [ "$p" = "." ]; then
        from="$SRC/"; to="$TN_DEST/"; parent="$TN_DEST"
    elif [ -d "$SRC/$p" ]; then
        from="$SRC/$p/"; to="$TN_DEST/$p/"; parent="$TN_DEST/$p"
    elif [ -f "$SRC/$p" ]; then
        from="$SRC/$p"; to="$TN_DEST/$p"; parent="$(dirname "$TN_DEST/$p")"
    else
        die "'$p' (from TN_PATHS) isn't in the source"
    fi
}

# ----------------------------------------------------------------- already in sync?
# Compares file contents (not just dates), so the same code from another branch
# or tag counts as in sync. Prints one line per file that would change; prints
# "?" if it couldn't tell (for example, the folder isn't on the NAS yet).
pending_changes() {
    local p out itemize=0
    # Every rsync since 2.6.7 (and macOS's openrsync) lists changes with -i; fall back to -v.
    rsync -i --version >/dev/null 2>&1 && itemize=1
    for p in $PATHS_LIST; do
        p="${p%/}"
        resolve_path "$p"
        if [ "$itemize" = 1 ]; then
            out="$(rsync "${RSYNC_BASE[@]}" -n -c -i "$from" "$REMOTE:$to" 2>/dev/null)" || { say "?"; return 0; }
            # < > c h are copies and creations; lines starting "." only touch dates or permissions.
            printf '%s\n' "$out" | grep -E '^([<>ch]|\*deleting)' || true
        else
            out="$(rsync "${RSYNC_BASE[@]}" -n -c -v "$from" "$REMOTE:$to" 2>/dev/null)" || { say "?"; return 0; }
            printf '%s\n' "$out" | grep -v -E '^(sending|building|sent |total size|created directory|$)|/$' || true
        fi
    done
}

CHANGES="$(pending_changes)" || exit 1
if [ -z "$CHANGES" ]; then
    if [ -z "$TN_TEST" ] || [ "$SKIP_TESTS" = 1 ]; then
        green_banner "ALREADY IN SYNC  -  NOTHING TO COPY" \
                     "" \
                     "$TN_HOST already has exactly these files." \
                     "Nothing was copied and $TN_APP wasn't restarted."
        exit 0
    fi
    why="$(last_tests_not_passed)"
    if [ -z "$why" ]; then
        lines=("ALREADY IN SYNC  -  TESTS ALREADY PASSED" "" \
               "$TN_HOST already has exactly these files, and the" \
               "last tests tnsync ran on them passed ($(state_get when)).")
        [ "$(state_get future)" = pass ] && lines+=("The future tests passed on them too.")
        lines+=("Nothing was copied and $TN_APP wasn't restarted.")
        green_banner "${lines[@]}"
        exit 0
    fi
    yellow_banner "ALL FILES ARE IN SYNC  -  RE-RUNNING TESTS" \
                  "" \
                  "$why" \
                  "Nothing will be copied and $TN_APP won't be restarted."
    if run_tests insync; then record_tests pass; exit 0; fi
    record_tests fail
    exit 1
fi

if [ "$TESTS_FIRST" = 1 ]; then
    run_tests before || exit 1
fi

# The NAS is about to get different code, so the last test result no longer applies.
[ "$DRY_RUN" = 1 ] || state_clear

COPIED=0
CHANGED=0   # files actually copied or deleted
for p in $PATHS_LIST; do
    p="${p%/}"
    resolve_path "$p"
    [ "$DRY_RUN" = 1 ] || ssh_run "mkdir -p '$parent'" || die "can't create $parent on TrueNAS (does $TN_USER own it?)"
    info "Copying $p"
    # Indent rsync's file list and drop its summary lines.
    if ! out="$(rsync "${RSYNC_ARGS[@]}" "$from" "$REMOTE:$to" 2>&1)"; then
        printf '%s\n' "$out" | sed 's/^/    /'
        fail "COPY FAILED  -  $TN_HOST MAY HAVE PART OF THE CODE" \
             "" \
             "rsync stopped partway (see the error above)." \
             "Fix it, then run 'tnsync $MODE' again."
    fi
    out="$(printf '%s\n' "$out" | grep -v -E '^(sending|building|sent |total size|created directory|$)' || true)"
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/    /'
    CHANGED=$((CHANGED + $(printf '%s\n' "$out" | grep -c -v -E '/$|^$' || true)))   # folders don't count
    COPIED=$((COPIED + 1))
done
if [ "$DRY_RUN" = 1 ]; then ok "Dry run: the files listed above would be copied"; else ok "Copied $COPIED path(s) to $TN_HOST"; fi

# ----------------------------------------------------------------- restart
finish() {   # the tests, unless they already ran first
    if [ "$TESTS_FIRST" = 1 ]; then
        [ "$DRY_RUN" = 1 ] || record_tests pass
        exit 0
    fi
    if run_tests after; then
        [ "$DRY_RUN" = 1 ] || record_tests pass
        exit 0
    fi
    [ "$DRY_RUN" = 1 ] || record_tests fail
    exit 1
}
[ "$DRY_RUN" = 1 ] && finish
if [ "$CHANGED" = 0 ]; then
    say "No files changed on $TN_HOST, so $TN_APP wasn't restarted."
    finish
fi
if [ "$RESTART" = "ask" ]; then
    if [ -t 0 ]; then
        read -r -p "Restart '$TN_APP' on $TN_HOST now? [y/N] " ans
        case "$ans" in y|Y|yes|YES) RESTART="yes" ;; *) RESTART="no" ;; esac
    else
        RESTART="no"
    fi
fi
if [ "$RESTART" != "yes" ]; then
    say "Not restarted. Run 'tnsync $MODE -y' or restart it in TrueNAS when ready."
    finish
fi

info "Restarting $TN_APP (this waits until TrueNAS has finished)…"
REMOTE_RESTART="a='$TN_APP'
out=\$(midclt call -j app.redeploy \"\$a\" 2>&1) && exit 0
out2=\$(sudo -n /usr/bin/midclt call -j app.redeploy \"\$a\" 2>&1) && exit 0
printf '%s\n%s\n' \"\$out\" \"\$out2\" | tail -n 6 >&2
exit 1"
if ssh_run "$REMOTE_RESTART"; then
    ok "Restarted $TN_APP — ready to try while the tests run"
else
    fail "COPIED, BUT $TN_APP COULDN'T BE RESTARTED" \
         "" \
         "Check the app name, and that $TN_USER may run midclt" \
         "(see the tnsync README). The tests weren't run."
fi
finish
