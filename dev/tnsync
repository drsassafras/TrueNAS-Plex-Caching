#!/usr/bin/env bash
#
# tnsync — copy a project's code to a TrueNAS app and (optionally) restart it.
#
#   tnsync local     the files in your folder right now, uncommitted changes included
#   tnsync master    the latest code on GitHub's default branch (main or master)
#   tnsync dev       the latest code on GitHub's dev branch
#   tnsync release   the newest release tag, e.g. v1.2.0
#   tnsync beta      the newest tag including pre-releases, e.g. v1.3.0-beta.1
#   tnsync init      set up tnsync for the project you're in
#
# Options:
#   -n, --dry-run    show what would be copied and run the tests; change nothing
#   -y, --yes        restart the app once the files are copied (without it, it isn't)
#   -N, --no-restart don't restart (the default)
#   --tests-first    copy nothing until the checks have passed
#   --skip-tests     don't run the project's tests and checks at all (nor install the packages they use)
#   --skip-future    run the current tests only, not the future ones (TN_FUTURE)
#   --release        the release checks too (TN_RELEASE), and the tests as for a release: for dev before it's released
#   --no-sample      Style Approval only checks: no sample made of the looks waiting, and no review opened once the
#                    rest is done (r makes the sample first then)
#   -h, --help       this help
#
# Everything runs at once, on a board of sections redrawn as they go (dev/board.py):
# the copy to TrueNAS and the restart, and each of these that .tnsync sets, in the
# code being copied — TN_TEST (the current tests), TN_FUTURE (the suite on the
# next Python, say: stopped if the current tests fail), TN_VALIDATE (the HTML,
# scripts and CSS checked), TN_TYPES (the Python validation: the type check),
# TN_BUILD (the build validation: the shell script, the workflows, the Dockerfile),
# TN_I18N (how far the translation catalogs are, overall: grey between releases, where they may lag; on master and on a
# --release run a check like the tests — main must ship complete — red when any text is untranslated),
# TN_RELEASE (everything that has to be true before dev is released, every run, as an overall readiness: grey between
# releases, saying what's still to go; with --release the blocking check it always was),
# TN_COVERAGE (what of the code the current tests reach, once they've passed: orange when there's a test to add, never red
# but on a --release run, where its release bar is a check like the others),
# TN_AUDIT (the security audits: which code no audit has seen, past its grace window: orange; red only on a --release
# run, where the release rules are a check like the others),
# TN_STYLE (the looks waiting for your approval: orange, a line that says how many and where to see them;
# it neither blocks the copy nor counts as a failure) — and TN_UPKEEP (the
# dependencies), in your folder. Each section is blue while it runs, then green,
# orange, red or grey (for the record: skipped, already in sync), its result in its own block (each block keeps its three lines
# from the start, so nothing moves); what a failed one printed goes above the
# board as it ends (scroll up to read it), so the board stays at the bottom.
# With --tests-first the copy waits for the checks, and happens only if they pass.
# Pressing Enter while they run stops the checks (their blocks say so; nothing is
# recorded; a copy under way finishes), so a newer version can be uploaded
# without waiting: run tnsync again.
# TNSYNC_MODE (local, master, dev, release, beta) tells the tests which was asked for.
# With --release, a check of its own too: TN_RELEASE (what has to be true before dev is released: the version, the
# translations…), red when it fails, as any check; and the checks get TNSYNC_RELEASE=1 and PLEXCACHE_I18N_RELEASE=1 (the
# suite as GitHub runs it for main). Without it, none of that: a normal run can't fail on what only a release needs.
# The dependencies: TN_UPKEEP looks while the rest runs (TNSYNC_UPKEEP=look:
# nothing moved), then again once the checks are done (TNSYNC_UPKEEP=move: a pin
# it moves can't change the code under the tests) — its first line "current"
# (green), "behind" or "cves" (yellow: new versions upstream, or none but CVEs to
# act on) or anything else (not checked); when it isn't
# current, the rest of what it said goes above the board.
#
# If the NAS already has exactly these files, nothing is copied or restarted.
# When the last tests tnsync ran there passed, it just says so (green banner);
# otherwise it runs the tests again (yellow banner first).
#
# Settings come from two files (KEY=value lines):
#   ~/.config/tnsync/config   shared:      TN_HOST, TN_USER, TN_PORT
#   <project>/.tnsync         per project: TN_APP, TN_DEST, TN_PATHS, TN_EXCLUDE, TN_TEST, TN_VALIDATE, TN_TYPES,
#                              TN_BUILD, TN_COVERAGE, TN_AUDIT, TN_FUTURE, TN_STYLE, TN_RELEASE, TN_UPKEEP (and may override any shared setting)
#
# Written for the bash 3.2 that ships with macOS.

set -eo pipefail

TNSYNC_VERSION="2.0.0"
GLOBAL_CONF="${TNSYNC_CONFIG:-$HOME/.config/tnsync/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tnsync"   # last test result per app

# ----------------------------------------------------------------- output
if [ -t 1 ]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_BLU=$'\033[34m'; C_OFF=$'\033[0m'
    # (the board's colours too, dev/board.py: blue under way, then green, orange, red, or grey for the record)
    C_BAD=$'\033[1;97;48;5;88m'    # bold white on deep red
    C_GOOD=$'\033[1;97;48;5;22m'   # bold white on forest green
    C_MEH=$'\033[1;30;48;5;214m'   # bold black on orange
    C_GREY=$'\033[1;97;48;5;240m'  # bold white on grey: a run that couldn't be set up, not one that failed
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_OFF=""; C_BAD=""; C_GOOD=""; C_MEH=""; C_GREY=""
fi
say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$C_BLU" "$C_OFF" "$*"; }
ok()   { printf '%s✔%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%sWarning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
die()  { printf '%stnsync:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

usage() {   # the comment at the top of this file
    awk 'NR >= 3 && /^#/ { print; next } NR >= 3 { exit }' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Loud blocks that can't be missed in the terminal.
banner() {   # banner <colour> <line>...
    local colour="$1" line
    shift
    printf '\n'
    for line in "" "$@" ""; do
        printf '%s  %-66s  %s\n' "$colour" "$line" "$C_OFF"
    done
    printf '\n'
}
red_banner()    { banner "$C_BAD" "$@" >&2; }
# shellcheck disable=SC2329 # (run from cleanup, the exit trap)
green_banner()  { banner "$C_GOOD" "$@"; }
# shellcheck disable=SC2329 # (run from cleanup, the exit trap)
yellow_banner() { banner "$C_MEH" "$@"; }
fail() { red_banner "$@"; exit 1; }   # a red block, then stop

# ----------------------------------------------------------------- args
ORIG_ARGS=("$@")   # (the copy's own section runs tnsync again with them: TNSYNC_STEP=sync)
MODE=""
DRY_RUN=0
RESTART="no"   # yes (-y) | no
SKIP_TESTS=0
SKIP_FUTURE=0
TESTS_FIRST=0
RELEASE=0
NO_SAMPLE=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run)    DRY_RUN=1 ;;
        -y|--yes)        RESTART="yes" ;;
        -N|--no-restart) RESTART="no" ;;
        --skip-tests)    SKIP_TESTS=1 ;;
        --skip-future)   SKIP_FUTURE=1 ;;
        --tests-first)   TESTS_FIRST=1 ;;
        --release)       RELEASE=1 ;;
        --no-sample)     NO_SAMPLE=1 ;;
        -h|--help)       usage 0 ;;
        --version)       say "tnsync $TNSYNC_VERSION"; exit 0 ;;
        -*)              die "unknown option: $1 (see tnsync --help)" ;;
        *)
            [ -z "$MODE" ] || die "only one of local, master, dev, release, beta or init"
            MODE="$1" ;;
    esac
    shift
done
case "$MODE" in
    local|master|main|dev|release|beta|init) ;;
    "") usage 1 ;;
    *)  die "unknown command: $MODE (use local, master, dev, release, beta or init)" ;;
esac

# ----------------------------------------------------------------- config
TN_HOST=""; TN_USER="truenas_admin"; TN_PORT="22"
TN_APP=""; TN_DEST=""; TN_PATHS="."; TN_EXCLUDE=".git .DS_Store __pycache__ *.pyc"; TN_TEST=""; TN_VALIDATE=""; TN_TYPES=""; TN_BUILD=""; TN_COVERAGE=""; TN_I18N=""; TN_AUDIT=""; TN_FUTURE=""; TN_STYLE=""; TN_RELEASE=""; TN_UPKEEP=""

# Read KEY=value lines. The file is parsed, never executed.
load_conf() {
    local file="$1" line key val n=0
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%%#*}"                                   # strip comments
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        case "$line" in
            *=*) ;;
            *) warn "$file line $n ignored: $line"; continue ;;
        esac
        key="${line%%=*}"; val="${line#*=}"
        case "$val" in                                       # strip one pair of quotes
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        case "$key" in
            TN_HOST|TN_USER|TN_PORT|TN_APP|TN_DEST|TN_PATHS|TN_EXCLUDE|TN_TEST|TN_VALIDATE|TN_TYPES|TN_BUILD|TN_COVERAGE|TN_I18N|TN_AUDIT|TN_FUTURE|TN_STYLE|TN_RELEASE|TN_UPKEEP) printf -v "$key" '%s' "$val" ;;
            *) warn "$file line $n: unknown setting $key" ;;
        esac
    done < "$file"
}

# The project's .tnsync: in this folder or one above it, but no higher than the repository's top (or your home folder,
# outside a repository), so one someone else left in a folder above (/tmp, say) is never taken; and only one that's
# your own file, that nobody else may change (what it sets runs as you: TN_TEST, …).
find_project_root() {
    local dir="$PWD" top here perms
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || top="$HOME"
    top="$(cd "$top" 2>/dev/null && pwd -P)" || top=""
    here="$(pwd -P)"
    [ -n "$top" ] || top="$here"
    case "$here/" in "$top"/*) ;; *) top="$here" ;; esac   # (not under it: this folder alone)
    while [ -n "$dir" ]; do
        if [ -f "$dir/.tnsync" ]; then
            perms="$(ls -ld "$dir/.tnsync")"
            { [ -O "$dir/.tnsync" ] && [ "${perms:5:1}" != w ] && [ "${perms:8:1}" != w ]; } \
                || die "$dir/.tnsync isn't used: it has to be your own file, that nobody else may change (chmod go-w)"
            printf '%s' "$dir"
            return 0
        fi
        [ "$(cd "$dir" && pwd -P)" != "$top" ] && [ "$dir" != "/" ] || break
        dir="$(dirname "$dir")"
    done
    die "no .tnsync file here or in a folder above it in this project. In your project, run: tnsync init"
}

# ----------------------------------------------------------------- init
do_init() {
    local root ans
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
    if [ ! -f "$GLOBAL_CONF" ]; then
        info "Shared settings ($GLOBAL_CONF)"
        read -r -p "  TrueNAS address (e.g. 192.168.1.10): " ans
        [ -n "$ans" ] || die "an address is needed"
        local host="$ans"
        read -r -p "  SSH user on TrueNAS [truenas_admin]: " ans
        local user="${ans:-truenas_admin}"
        mkdir -p "$(dirname "$GLOBAL_CONF")"
        printf '# tnsync shared settings\nTN_HOST=%s\nTN_USER=%s\nTN_PORT=22\n' "$host" "$user" > "$GLOBAL_CONF"
        ok "wrote $GLOBAL_CONF"
    fi
    if [ -f "$root/.tnsync" ]; then
        ok "$root/.tnsync already exists"
        return 0
    fi
    info "Project settings ($root/.tnsync)"
    read -r -p "  TrueNAS app name to restart (e.g. myapp-dev): " ans
    local app="$ans"
    read -r -p "  Folder on TrueNAS to copy into (e.g. /mnt/tank/apps/$app/src): " ans
    local dest="$ans"
    read -r -p "  What to copy from this project [.]: " ans
    local paths="${ans:-.}"
    cat > "$root/.tnsync" <<EOF
# tnsync settings for this project. See: tnsync --help
TN_APP=$app
TN_DEST=$dest
# Folders/files in this project to copy, separated by spaces ("." = everything).
TN_PATHS=$paths
# Patterns never copied.
TN_EXCLUDE=.git .DS_Store __pycache__ *.pyc
# The tests, run in the code being copied while it's copied (or first, with --tests-first).
# e.g. TN_TEST=python3 -m unittest   or   TN_TEST=npm test
TN_TEST=
# Checks of their own, each in a section beside the tests: the HTML, scripts and CSS; the types; the build's files.
# e.g. TN_VALIDATE=npx eslint .   TN_TYPES=npx pyright   TN_BUILD=shellcheck *.sh
TN_VALIDATE=
TN_TYPES=
TN_BUILD=
# What of the code the tests reach, once they've passed (the coverage TN_TEST saved): exit 0 enough, 1 a test to add,
# 3 nothing measured (TN_TEST without --coverage) (orange; red only with --release). e.g. TN_COVERAGE=python3 dev/coverage.py --tnsync
TN_COVERAGE=
# How far the translation catalogs are, overall. The tool decides from TNSYNC_MODE and TNSYNC_RELEASE: exit 0 complete,
# 3 in progress (grey — between releases they may lag); on master (main must ship complete) and on a --release run,
# red when any text is untranslated, and the run fails. e.g. TN_I18N=python3 dev/i18n.py --tnsync
TN_I18N=

# The security audits: which code no audit has seen past its grace window (orange; with --release, the release rules: red).
# e.g. TN_AUDIT=python3 dev/audit.py
TN_AUDIT=
# The suite on the next Python, say: alongside, stopped if TN_TEST fails.
# e.g. TN_FUTURE=python3 dev/future.py
TN_FUTURE=
# Looks waiting for approval (a style guide), in a section of their own: exit 0 all approved, 1 some wait (orange,
# its output not printed: its last line, or what it sends with dev/progress.said, says how many and where to see them).
# e.g. TN_STYLE=python3 dev/style.py check
TN_STYLE=
# The release checks, every run, as an overall readiness. The tool decides from TNSYNC_RELEASE: exit 0 ready, 3 getting
# there (grey — "4 of 7 ready", and what's still to go); with --release, the blocking check it always was (red when it
# fails). e.g. TN_RELEASE=python3 dev/release.py --tnsync
TN_RELEASE=
# The dependencies, shown in a last box: a command whose first line is current, behind, cves (or else: not checked),
# the rest the box's lines. e.g. TN_UPKEEP=python3 dev/upkeep.py --tnsync
TN_UPKEEP=
EOF
    ok "wrote $root/.tnsync"
}

if [ "$MODE" = "init" ]; then
    do_init
    exit 0
fi

ROOT="$(find_project_root)" || exit 1
[ -n "${TNSYNC_STEP:-}" ] || [ "$ROOT" = "$PWD" ] || info "Settings from $ROOT/.tnsync"
load_conf "$GLOBAL_CONF"
load_conf "$ROOT/.tnsync"

[ -n "$TN_HOST" ] || die "TN_HOST isn't set: put it in $GLOBAL_CONF, or run: tnsync init"
[ -n "$TN_APP" ]  || die "TN_APP isn't set in $ROOT/.tnsync"
[ -n "$TN_DEST" ] || die "TN_DEST isn't set in $ROOT/.tnsync"
# (TN_HOST and TN_USER: plain names, never one ssh would read as an option, -oProxyCommand=… say)
[[ "$TN_HOST" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "TN_HOST '$TN_HOST' doesn't look like a host name or address (letters, digits, . _ -)"
[[ "$TN_USER" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || die "TN_USER '$TN_USER' doesn't look like a user name (letters, digits, . _ -)"
[[ "$TN_APP" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "TN_APP '$TN_APP' doesn't look like a TrueNAS app name"
[[ "$TN_DEST" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "TN_DEST must be an absolute path without spaces: '$TN_DEST'"
# (rsync --delete works on it: never the NAS's root, however it's written — //, /., /mnt/..)
TN_DEST="$(printf '%s' "$TN_DEST" | tr -s /)"
TN_DEST="${TN_DEST%/}"
[ -n "$TN_DEST" ] || die "TN_DEST can't be /"
case "$TN_DEST/" in */./*|*/../*) die "TN_DEST can't have . or .. in it: '$TN_DEST'" ;; esac
check_path() {   # check_path <TN_PATHS entry> — inside the project and TN_DEST: TN_DEST's letters, no .., no quotes
    [[ "$1" =~ ^[A-Za-z0-9._][A-Za-z0-9._/-]*$ ]] || die "TN_PATHS entries must be paths in the project, without spaces or quotes: $1"
    case "/$1/" in */../*) die "TN_PATHS entries must be inside the project (no ..): $1" ;; esac
}
set -f
for p in $TN_PATHS; do check_path "${p%/}"; done
set +f
[[ "$TN_PORT" =~ ^[0-9]+$ ]] || die "TN_PORT must be a number"

# ----------------------------------------------------------------- packages
# The packages the tests use, the dev tools' (dev/package-lock.json): npm ci when there are none yet or the lock has
# changed since (node_modules/.package-lock.json is npm's note of what it installed), with no package's install scripts
# run (none of them needs one). Without npm, a warning; the tests then say what's missing. Not with --skip-tests: no tests.
ensure_packages() {
    local dir="$ROOT/dev" lock="$ROOT/dev/package-lock.json"
    [ -f "$lock" ] || return 0
    if [ -f "$dir/node_modules/.package-lock.json" ] && [ ! "$lock" -nt "$dir/node_modules/.package-lock.json" ]; then return 0; fi
    if ! command -v npm >/dev/null 2>&1; then
        warn "npm isn't installed, so the packages in dev can't be: install Node (nodejs.org) for the tests that use them"
        return 0
    fi
    info "Installing the packages in dev (npm ci: its package-lock.json has changed)…"
    npm ci --prefix "$dir" --ignore-scripts --no-audit --no-fund >/dev/null || die "npm ci --prefix dev failed (see the error above)"
}
# (the copy's section: the run that started it has seen to them)
[ -n "${TNSYNC_STEP:-}" ] || [ "$SKIP_TESTS" = 1 ] || ensure_packages

# ----------------------------------------------------------------- source
TMP=""
# The SSH connection's socket, shared by the run's sections: in a folder only you own and can open (0700), never a name
# anyone could take first in the shared /tmp. Under the state folder; a shorter one of your own in /tmp when that path
# is too long for a socket's name.
SSH_CTL_DIR="$STATE_DIR/ssh"
[ "${#SSH_CTL_DIR}" -le 60 ] || SSH_CTL_DIR="/tmp/tnsync-ssh-$(id -u)"
mkdir -p "$SSH_CTL_DIR" 2>/dev/null && chmod 700 "$SSH_CTL_DIR" 2>/dev/null
{ [ -d "$SSH_CTL_DIR" ] && [ ! -L "$SSH_CTL_DIR" ] && [ -O "$SSH_CTL_DIR" ]; } \
    || die "can't keep the SSH connection's socket in $SSH_CTL_DIR (a folder of your own, only you can open): see that it's yours"
SSH_CTL="$SSH_CTL_DIR/%C"
BOARD_DIR=""   # the board's plan, results and logs (dev/board.py), while it's there
# The last box: the dependencies (TN_UPKEEP), from your folder — where a version it moves belongs — not the copy. Once a
# run, at its end, whatever the tests did; not when tnsync was interrupted (Ctrl-C) or stopped before it got going.
# UPKEEP_OUT: what the board's Dependencies section said (else the command is run here, now).
UPKEEP_READY=0
UPKEEP_OUT=""
# shellcheck disable=SC2329 # (run from cleanup, the exit trap)
upkeep_banner() {
    local out status line lines=()
    [ -n "$TN_UPKEEP" ] && [ "$UPKEEP_READY" = 1 ] || return 0
    UPKEEP_READY=0
    if [ -n "$UPKEEP_OUT" ]; then
        return 0   # (the board said it: in its block, and what more there was above the board)
    else
        info "Checking the dependencies: $TN_UPKEEP"
        out="$( cd "$ROOT" && PYTHONDONTWRITEBYTECODE=1 bash -c "$TN_UPKEEP" < /dev/null 2>&1 )" || true
    fi
    status="$(printf '%s\n' "$out" | head -n 1)"
    while IFS= read -r line; do lines+=("$line"); done < <(printf '%s\n' "$out" | tail -n +2)
    case "$status" in
        current) green_banner "${lines[@]}" ;;
        behind|cves) yellow_banner "${lines[@]}" ;;
        *)       banner "$C_GREY" "DEPENDENCIES NOT CHECKED" "" "$TN_UPKEEP said:" "${status:0:66}" "${lines[@]}" ;;
    esac
}
# shellcheck disable=SC2329 # (run by the trap below, when tnsync exits)
cleanup() {
    local rc=$?
    [ -z "${TNSYNC_STEP:-}" ] || return 0   # (the copy's section: the connection is the run's that started it)
    if [ "$rc" -lt 128 ]; then upkeep_banner || true; fi
    if [ -n "$TMP" ]; then rm -rf "$TMP"; fi
    if [ -n "$BOARD_DIR" ]; then rm -rf "$BOARD_DIR"; fi
    ssh -o ControlPath="$SSH_CTL" -O exit -p "$TN_PORT" -- "$TN_USER@$TN_HOST" >/dev/null 2>&1 || true
}
trap cleanup EXIT

capital() { printf '%s%s' "$(printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]')" "${1:1}"; }   # (bash 3.2 has no ${x^})

SRC_SHA=""      # (a copy from git: the commit it is)
SRC_COMMIT=""   # (the commit checked, on the board's header after the label: "a1b2c3d", "+ uncommitted" too for local)
export_ref() {   # export_ref <ref> <label> — the label the board's header shows
    local ref="$1"
    git -C "$ROOT" rev-parse --verify --quiet "$ref^{commit}" >/dev/null || die "can't find $ref in this repository"
    SRC_SHA="$(git -C "$ROOT" rev-parse "$ref^{commit}")"   # (the copy's lines, as git knows them: TN_AUDIT's blame, TN_COVERAGE's fresh and settled)
    TMP="$(mktemp -d "${TMPDIR:-/tmp}/tnsync.XXXXXX")"
    git -C "$ROOT" archive "$ref" | tar -x -C "$TMP"
    # The packages installed in your folder (npm ci: node_modules, never in git) linked in, so the tests that use them
    # run on this copy as on your folder. They're never copied to the NAS (RSYNC_BASE).
    local nm rel
    while IFS= read -r nm; do
        rel="${nm#"$ROOT"/}"
        if [ -d "$TMP/$(dirname "$rel")" ] && [ ! -e "$TMP/$rel" ]; then ln -s "$nm" "$TMP/$rel"; fi
    done < <(find "$ROOT" -maxdepth 3 -name node_modules -type d -prune 2>/dev/null)
    SRC="$TMP"
    SRC_LABEL="$2"
    SRC_COMMIT="$(git -C "$ROOT" rev-parse --short "$ref^{commit}")"
}

newest_tag() {   # newest_tag <regex>
    # versionsort.suffix=- makes 1.0.0-beta.1 sort before 1.0.0
    git -C "$ROOT" -c versionsort.suffix=- tag -l --sort=-v:refname | grep -E "$1" | head -n 1 || true
}

if [ -n "${TNSYNC_STEP:-}" ]; then
    SRC="$TNSYNC_SRC"   # (the copy's section: the code the run that started it chose)
else
case "$MODE" in
    local)
        SRC="$ROOT"
        SRC_LABEL="Local Copy"
        if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
            b="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
            [ -z "$b" ] || [ "$b" = HEAD ] || SRC_LABEL="$SRC_LABEL on $(capital "$b")"   # (a detached HEAD: the commit alone)
            SRC_COMMIT="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
            if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
                SRC_COMMIT="${SRC_COMMIT:+$SRC_COMMIT }+ uncommitted"
            fi
        fi
        ;;
    master|main|dev|release|beta)
        git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "'tnsync $MODE' needs a git repository. For your folder as it is, run: tnsync local"
        info "Fetching from GitHub…"
        git -C "$ROOT" fetch --quiet --tags origin || fail "CAN'T REACH GITHUB  -  NOTHING WAS COPIED" \
            "" \
            "git fetch failed (see the error above)." \
            "Check that you're online, then run it again: tnsync $MODE"
        if [ "$MODE" = "master" ] || [ "$MODE" = "main" ]; then
            ref="$(git -C "$ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
            if [ -z "$ref" ]; then
                git -C "$ROOT" remote set-head origin --auto >/dev/null 2>&1 || true
                ref="$(git -C "$ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
            fi
            if [ -z "$ref" ]; then
                for b in main master; do
                    if git -C "$ROOT" rev-parse --verify --quiet "origin/$b" >/dev/null; then ref="origin/$b"; break; fi
                done
            fi
            [ -n "$ref" ] || die "can't work out the default branch on origin"
            export_ref "$ref" "Committed Copy on $(capital "${ref#origin/}")"
        elif [ "$MODE" = "dev" ]; then
            git -C "$ROOT" rev-parse --verify --quiet "origin/dev" >/dev/null || die "there's no dev branch on origin"
            export_ref "origin/dev" "Committed Copy on Dev"
        elif [ "$MODE" = "release" ]; then
            tag="$(newest_tag '^v?[0-9]+(\.[0-9]+)*$')"
            [ -n "$tag" ] || die "no release tags (like v1.2.0) yet"
            export_ref "$tag" "Release Copy of $tag"
        else
            tag="$(newest_tag '^v?[0-9]+(\.[0-9]+)*(-.+)?$')"
            [ -n "$tag" ] || die "no version tags (like v1.3.0-beta.1) yet"
            export_ref "$tag" "Beta Copy of $tag"
        fi
        ;;
esac
fi

# ----------------------------------------------------------------- copy
REMOTE="$TN_USER@$TN_HOST"
SSH_ARGS=(-o ControlMaster=auto -o "ControlPath=$SSH_CTL" -o ControlPersist=120 -p "$TN_PORT")
SSH_OPTS="${SSH_ARGS[*]}"   # (the same, as one string: rsync's -e)
# shellcheck disable=SC2029 # (the commands are put together here on purpose: each is run as written on the NAS)
ssh_run() { ssh "${SSH_ARGS[@]}" -- "$REMOTE" "$@"; }

if [ -z "${TNSYNC_STEP:-}" ]; then
    UPKEEP_READY=1   # (from here on a run ends with the dependencies' box)
    say ""   # (what this run is, and how to stop it: the board's header)
fi

# ----------------------------------------------------------------- last test result
# One small file per NAS folder, written only when the tests ran on exactly the
# code that's on the NAS. Read as KEY=value lines, never run.
STATE_FILE="$STATE_DIR/$(printf '%s' "$TN_HOST:$TN_DEST" | tr -c 'A-Za-z0-9._-' '_')"
state_get() { [ -f "$STATE_FILE" ] && sed -n "s/^$1=//p" "$STATE_FILE" | head -n 1; true; }
state_clear() { rm -f "$STATE_FILE"; }
record_tests() {   # record_tests pass|fail|aborted — only if the tests actually ran (aborted: stopped with Enter; tested again next time)
    if [ "$TESTS_RAN" != 1 ]; then state_clear; return 0; fi
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    {
        printf 'result=%s\nmode=%s\nwhen=%s\nat=%s\ntest=%s\ncode=%s\nfuture=%s\nfuture_test=%s\nrelease=%s\n' "$1" "$MODE" "$(date '+%Y-%m-%d %H:%M')" "$(date +%s)" "$TEST_SIG" "$CODE_SIG" "$FUTURE_RESULT" "$FUTURE_CMD" "$RELEASE"
        # each check's result line, for its block next time while the code stays the same (what it ran on, what it found)
        local id
        for id in "${CHECK_IDS[@]}"; do [ -z "$RES" ] || printf 'last_%s=%s\n' "$id" "$(res_get "${id}_last")"; done
    } > "$STATE_FILE" 2>/dev/null || true
}
ago() {   # ago <epoch seconds> — how long ago, as people say it: "just now", "4 minutes ago", "1 week ago"
    local s=$(( $(date +%s) - $1 )) n unit
    if [ "$s" -lt 60 ]; then printf 'just now'; return; fi
    if [ "$s" -lt 3600 ]; then n=$(( s / 60 )); unit=minute
    elif [ "$s" -lt 86400 ]; then n=$(( s / 3600 )); unit=hour
    elif [ "$s" -lt 604800 ]; then n=$(( s / 86400 )); unit=day
    elif [ "$s" -lt 2629800 ]; then n=$(( s / 604800 )); unit=week
    elif [ "$s" -lt 31557600 ]; then n=$(( s / 2629800 )); unit=month
    else n=$(( s / 31557600 )); unit=year; fi
    [ "$n" = 1 ] || unit="${unit}s"
    printf '%s %s ago' "$n" "$unit"
}
TESTS_RAN=0            # (set when the board ran the checks)
FUTURE_RESULT="none"   # pass | fail | none — what the state file keeps of the future tests
# The checks this run, as one line (the current ones: a change to any of them means testing again).
# What the checks ran on: every file of the checkout git keeps or would (not what it ignores), so a change to the tests or
# the dev tools — not copied to TrueNAS, so not among the changes the copy finds — tests again too. Empty when it can't be
# worked out (not a git checkout): then only the copy's changes count, as before. A file git keeps that's gone from the
# folder (deleted, not yet committed) is left out of the sum, so its going counts as a change, and never stops the run.
code_sig() {
    local sum=shasum; command -v shasum >/dev/null 2>&1 || sum=sha256sum
    command -v git >/dev/null 2>&1 && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
    (cd "$ROOT" && git ls-files -z -co --exclude-standard | { xargs -0 "$sum" 2>/dev/null || true; } | "$sum" | cut -d' ' -f1)
}
CODE_SIG="$(code_sig)"
TEST_SIG="$TN_TEST"
[ -z "$TN_VALIDATE$TN_TYPES$TN_BUILD" ] || TEST_SIG="$TN_TEST | $TN_VALIDATE | $TN_TYPES"
[ -z "$TN_BUILD" ] || TEST_SIG="$TEST_SIG | $TN_BUILD"   # (as it was without it: a .tnsync without TN_BUILD isn't tested again)
[ -z "$TN_COVERAGE" ] || TEST_SIG="$TEST_SIG | coverage: $TN_COVERAGE"
[ -z "$TN_RELEASE" ] || TEST_SIG="$TEST_SIG | release: $TN_RELEASE"
[ -z "$TN_I18N" ] || TEST_SIG="$TEST_SIG | i18n: $TN_I18N"
# The future tests asked for this run: TN_FUTURE, or nothing with --skip-future (or no tests at all).
FUTURE_CMD=""
[ "$SKIP_TESTS" = 1 ] || [ "$SKIP_FUTURE" = 1 ] || FUTURE_CMD="$TN_FUTURE"
# Prints why the last result doesn't count for this run; prints nothing if it passed.
last_tests_not_passed() {
    local result when
    result="$(state_get result)"; when="$(state_get when)"
    if [ -z "$result" ]; then
        say "tnsync has no test result for this code yet."
    elif [ "$result" = "aborted" ]; then
        say "The last test run was stopped with Enter ($when)."
    elif [ "$result" != "pass" ]; then
        say "The last test run failed ($when)."
    elif [ "$RELEASE" = 1 ] && [ "$(state_get release)" != 1 ]; then
        say "The last tests weren't a release run (--release)."
    elif [ "$(state_get test)" != "$TEST_SIG" ]; then
        say "TN_TEST, TN_VALIDATE, TN_TYPES, TN_BUILD or TN_COVERAGE has changed since the last test run."
    elif [ -n "$CODE_SIG" ] && [ "$(state_get code)" != "$CODE_SIG" ]; then
        say "The code has changed since the last test run (the tests or the dev tools, if not the app)."
    elif [ "$(state_get mode)" != "$MODE" ]; then
        say "The last tests ran for 'tnsync $(state_get mode)', not 'tnsync $MODE'."
    elif [ "$(state_get future_test)" != "$FUTURE_CMD" ]; then
        say "TN_FUTURE has changed since the last test run."
    fi
}

# ----------------------------------------------------------------- the copy's connection
REMOTE_RESTART="a='$TN_APP'
out=\$(midclt call -j app.redeploy \"\$a\" 2>&1) && exit 0
out2=\$(sudo -n /usr/bin/midclt call -j app.redeploy \"\$a\" 2>&1) && exit 0
printf '%s\n%s\n' \"\$out\" \"\$out2\" | tail -n 6 >&2
exit 1"
command -v rsync >/dev/null 2>&1 || die "rsync isn't installed (on a Mac: it normally is; try 'brew install rsync')"

set -f   # keep exclude patterns like *.pyc from expanding here
RSYNC_BASE=(-a --delete -e "ssh $SSH_OPTS" --exclude node_modules)   # (installed packages: npm ci makes them where they're needed)
for pat in $TN_EXCLUDE; do RSYNC_BASE+=(--exclude "$pat"); done
# Links: never one that leads out of the copy (a link committed to /mnt/... would be the app's on the NAS): --safe-links
# skips those; an rsync without it copies no links at all (-a less -l).
if rsync --safe-links --version >/dev/null 2>&1; then RSYNC_BASE+=(--safe-links); else RSYNC_BASE=(-rptgoD "${RSYNC_BASE[@]:1}"); fi
RSYNC_ARGS=("${RSYNC_BASE[@]}")
[ "$DRY_RUN" = 1 ] && RSYNC_ARGS+=(-n -v) || RSYNC_ARGS+=(-v)
PATHS_LIST=$TN_PATHS
set +f

resolve_path() {   # resolve_path <TN_PATHS entry> — sets from, to, parent
    local p="$1"
    check_path "$p"
    if [ "$p" = "." ]; then
        from="$SRC/"; to="$TN_DEST/"; parent="$TN_DEST"
    elif [ -d "$SRC/$p" ]; then
        from="$SRC/$p/"; to="$TN_DEST/$p/"; parent="$TN_DEST/$p"
    elif [ -f "$SRC/$p" ]; then
        from="$SRC/$p"; to="$TN_DEST/$p"; parent="$(dirname "$TN_DEST/$p")"
    else
        die "'$p' (from TN_PATHS) isn't in the source"
    fi
}


# ----------------------------------------------------------------- the copy (its section on the board)
files_n() { if [ "$1" = 1 ]; then printf '1 file'; else printf '%s files' "$1"; fi; }   # files_n <n> — "1 file", "2 files"
# feed <done> <total> <label> [ticking] — the copy's bar, as dev/progress.py sends one to the board (PLEXCACHE_PROGRESS=feed)
feed() {
    local label ticking=false
    label="$(printf '%s' "$3" | tr -d '\000-\037')"
    label="${label//\\/\\\\}"; label="${label//\"/\\\"}"
    [ -z "${4:-}" ] || ticking=true
    printf '\036{"bar":"sync","done":%d,"total":%d,"bad":0,"label":"%s","ticking":%s,"unit":"files","workers":1}\n' "$1" "$2" "$label" "$ticking"
}
# sync_step — what the board's first section runs (tnsync again, TNSYNC_STEP=sync): each TN_PATHS entry copied, its
# files said as they go, then the restart with -y. Exit 0 when done, 1 when the copy failed (the NAS may have part of the
# code), 4 when it was copied but the app couldn't be restarted.
sync_step() {
    local p line n=0 total="${TNSYNC_TOTAL:-0}" changed=0 copied=0 counts rc
    if [ "$RESTART" = "yes" ] && [ "$DRY_RUN" != 1 ]; then total=$((total + 1)); fi
    [ "$DRY_RUN" = 1 ] || state_clear   # (the NAS is about to get different code: the last test result no longer applies)
    feed 0 "$total" "starting"
    counts="$(mktemp "${TMPDIR:-/tmp}/tnsync-count.XXXXXX")"
    for p in $PATHS_LIST; do
        p="${p%/}"
        resolve_path "$p"
        if [ "$DRY_RUN" != 1 ] && ! ssh_run "mkdir -p -- $(printf '%q' "$parent")" 2>&1; then
            say "Can't create $parent on TrueNAS (does $TN_USER own it?)"
            rm -f "$counts"; return 1
        fi
        say "Copying $p"
        # rsync's file list, a line each (its summary lines dropped), each file moving the bar on; folders don't count
        rc=0
        rsync "${RSYNC_ARGS[@]}" "$from" "$REMOTE:$to" 2>&1 | {
            while IFS= read -r line; do
                case "$line" in "sending "*|"building "*|"sent "*|"total size"*|"created directory"*|"") continue ;; esac
                say "    $line"
                case "$line" in */) continue ;; esac
                n=$((n + 1)); changed=$((changed + 1))
                feed "$n" "$total" "$line"
            done
            printf '%s %s\n' "$n" "$changed" > "$counts"
        } || rc=$?
        read -r n changed < "$counts" || true
        if [ "$rc" != 0 ]; then
            say "rsync stopped partway (see above): $TN_HOST may have part of the code."
            rm -f "$counts"; return 1
        fi
        copied=$((copied + 1))
    done
    rm -f "$counts"
    # (its last line in the form every block's is: facts joined with " · ", no full stop — dev/progress.py's result)
    if [ "$DRY_RUN" = 1 ]; then feed "$n" "$n" "files · rsync to $TN_APP (dry run)"; say "Dry run · $(files_n "$changed") would be copied"; return 0; fi
    if [ "$changed" = 0 ]; then
        feed "$n" "$n" "files · rsync to $TN_APP"; say "No files changed · $TN_APP not restarted"; return 0
    fi
    if [ "$RESTART" != "yes" ]; then
        feed "$n" "$n" "files · rsync to $TN_APP"; say "Copied $(files_n "$changed") · $TN_APP not restarted · to restart it too: tnsync $MODE -y"; return 0
    fi
    feed "$n" "$((n + 1))" "restarting $TN_APP (TrueNAS redeploys it)" ticking
    say "Restarting $TN_APP…"
    if ssh_run "$REMOTE_RESTART" 2>&1; then
        feed "$((n + 1))" "$((n + 1))" "steps · rsync to $TN_APP, restart"
        say "Copied $(files_n "$changed") · restarted $TN_APP"
        return 0
    fi
    say "Copied $(files_n "$changed") · $TN_APP couldn't be restarted: check the app name, and that $TN_USER may run midclt (see the tnsync README)"
    return 4
}
if [ "${TNSYNC_STEP:-}" = "sync" ]; then
    rc=0; sync_step || rc=$?
    exit "$rc"
fi

# (a NAS out of reach is the Sync block's to say, red, with what ssh said; the checks run all the same)
UNREACHABLE=""
if ! UNREACHABLE="$(ssh_run "true" 2>&1)"; then
    UNREACHABLE="${UNREACHABLE:-ssh said nothing}"
else
    UNREACHABLE=""
fi

# ----------------------------------------------------------------- already in sync?
# Compares file contents (not just dates), so the same code from another branch
# or tag counts as in sync. Prints one line per file that would change; prints
# "?" if it couldn't tell (for example, the folder isn't on the NAS yet).
pending_changes() {
    local p out itemize=0
    # Every rsync since 2.6.7 (and macOS's openrsync) lists changes with -i; fall back to -v.
    rsync -i --version >/dev/null 2>&1 && itemize=1
    for p in $PATHS_LIST; do
        p="${p%/}"
        resolve_path "$p"
        if [ "$itemize" = 1 ]; then
            out="$(rsync "${RSYNC_BASE[@]}" -n -c -i "$from" "$REMOTE:$to" 2>/dev/null)" || { say "?"; return 0; }
            # < > c h are copies and creations; lines starting "." only touch dates or permissions.
            printf '%s\n' "$out" | grep -E '^([<>ch]|\*deleting)' || true
        else
            out="$(rsync "${RSYNC_BASE[@]}" -n -c -v "$from" "$REMOTE:$to" 2>/dev/null)" || { say "?"; return 0; }
            printf '%s\n' "$out" | grep -v -E '^(sending|building|sent |total size|created directory|$)|/$' || true
        fi
    done
}

# ----------------------------------------------------------------- the board
# Everything at once, on dev/board.py's board (next to this script): a section for the copy (unless the files are already
# in sync) and one for each check .tnsync sets, the dependencies last. Then the boxes that say where that leaves the NAS.
self_dir() {   # the folder this script is really in (through any symlink: tnsync on your PATH)
    local f="$0" l
    while [ -L "$f" ]; do
        l="$(readlink "$f")"
        case "$l" in /*) f="$l" ;; *) f="$(dirname "$f")/$l" ;; esac
    done
    cd "$(dirname "$f")" && pwd
}
SELF="$(self_dir)/$(basename "$0")"
BOARD="$(self_dir)/board.py"
json_str() {   # json_str <text> — as a JSON string
    local s
    s="$(printf '%s' "$1" | tr -d '\000-\037')"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}
PLAN=""
plan_add() { PLAN="${PLAN:+$PLAN,
}$1"; }
CHECK_IDS=()   # the checks on the board, in order
# What every check is told: which command this is, the repository (the code may be a copy from git), and a release run
CHECK_ENV="\"TNSYNC_MODE\": $(json_str "$MODE"), \"TNSYNC_REPO\": $(json_str "$ROOT")"
[ -z "$SRC_SHA" ] || CHECK_ENV="$CHECK_ENV, \"TNSYNC_COMMIT\": $(json_str "$SRC_SHA")"
[ "$RELEASE" != 1 ] || CHECK_ENV="$CHECK_ENV, \"TNSYNC_RELEASE\": \"1\", \"PLEXCACHE_I18N_RELEASE\": \"1\""
check_section() {   # check_section <id> <title> <command> [extra JSON fields]
    [ -n "$3" ] || return 0
    CHECK_IDS+=("$1")
    plan_add "{\"id\": \"$1\", \"title\": $(json_str "$2"), \"cmd\": $(json_str "$3"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"env\": {$CHECK_ENV}${4:+, $4}}"
}
json_ids() {   # json_ids <id>... — as a JSON list
    local out="" id
    for id in "$@"; do out="${out:+$out, }\"$id\""; done
    printf '[%s]' "$out"
}
RES=""
res_get() { sed -n "s/^$1=//p" "$RES" | head -n 1; }
# The Sync block when there's nothing to copy, or no NAS to copy to: a section that only tells (info: grey when it's done,
# its header that; or red, when its command fails). told_sync <header> <exit code> <line>...
TOLD_SYNC=""
told_sync() {
    local head="$1" rc="$2" cmd=""
    shift 2
    cmd="$(printf 'printf "%%s\\n" %s; exit %s' "$(printf '%q ' "$@")" "$rc")"
    TOLD_SYNC="{\"id\": \"sync\", \"title\": $(json_str "Sync to $TN_HOST"), \"cmd\": $(json_str "$cmd"), \"cwd\": $(json_str "$ROOT"), \"info\": $(json_str "$head")}"
}
# A block that only tells, grey: told_section <id> <title> <header> <line>
told_section() {
    plan_add "{\"id\": \"$1\", \"title\": $(json_str "$2"), \"cmd\": $(json_str "printf '%s\\n' $(printf '%q' "$4")"), \"info\": $(json_str "$3")}"
}
# A check that already passed on this code: its block says so, grey, and nothing runs. passed_section <id> <title> <cmd> <line>
# The Security Audit block: which app code no audit has seen, past its grace window — a warning (orange) that neither blocks
# the copy nor fails the run; on a --release run its release rules are a check like the others (red when they aren't
# met). It reads the audits and git, not the tests, so it runs straight away, even on code that already passed. audit_section
audit_section() {
    [ -n "$TN_AUDIT" ] || return 0
    local warn=", \"warn\": {\"rc\": 1, \"note\": \"code to audit\"}"
    # a, once it says there's code to audit and while the board runs: the audits page (dev/auditgui.py), in your
    # folder, where an audit can be started; it stays open after the board, until its page is closed
    warn="$warn, \"key\": {\"key\": \"a\", \"cmd\": $(json_str "$TN_AUDIT gui"), \"cwd\": $(json_str "$ROOT"), \"does\": \"Open Audits\", \"opens\": \"the audits page\", \"line\": \"press a to open the audits page\"}"
    if [ "$RELEASE" = 1 ]; then warn=""; CHECK_IDS+=("audit"); fi
    plan_add "{\"id\": \"audit\", \"title\": \"Security Audit\", \"cmd\": $(json_str "$TN_AUDIT"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"env\": {$CHECK_ENV}$warn}"
}
passed_section() {
    [ -n "$3" ] || return 0
    plan_add "{\"id\": \"$1\", \"title\": $(json_str "$2"), \"cmd\": $(json_str "printf '%s\\n' $(printf '%q' "$4")"), \"info\": \"already passed\"}"
}
# The Coverage block: once the current tests have passed (they saved what they reached), what's still to add — a warning
# (orange) that neither blocks the copy nor fails the run; but on a --release run its release bar is a check like the
# others (red when it isn't met). coverage_section <the sections it waits for, as JSON>
coverage_section() {
    [ -n "$TN_COVERAGE" ] || return 0
    local warn=", \"warn\": {\"rc\": 1, \"note\": \"tests to add\", \"more\": {\"3\": \"not measured\"}}"   # (3: nothing saved, TN_TEST without --coverage)
    if [ "$RELEASE" = 1 ]; then warn=""; CHECK_IDS+=("coverage"); fi
    plan_add "{\"id\": \"coverage\", \"title\": \"Coverage\", \"cmd\": $(json_str "$TN_COVERAGE"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"after\": $1, \"env\": {$CHECK_ENV}$warn}"
}
# The Translations and Release blocks run every time, and their tool is the one place that decides how strict they
# are, from TNSYNC_MODE and TNSYNC_RELEASE (so the board, and anything else that reads them, can't disagree): exit 0
# passed, 3 only telling (grey — the catalogs lagging between releases, the readiness still building), 1 a failure
# (red — untranslated texts on master or a --release run, a release check not met on a --release run).
# The Translations block: how far the catalogs are, overall (TN_I18N). i18n_section
i18n_section() {
    [ -n "$TN_I18N" ] || return 0
    CHECK_IDS+=("i18n")
    plan_add "{\"id\": \"i18n\", \"title\": \"Translations\", \"cmd\": $(json_str "$TN_I18N"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"env\": {$CHECK_ENV}, \"tell\": {\"rc\": 3, \"note\": \"in progress\"}}"
}
# The Release block: everything that has to be true before dev is released (TN_RELEASE), as an overall readiness,
# its line saying what's still to go. release_section <the sections it waits for, as JSON>
release_section() {
    [ -n "$TN_RELEASE" ] || return 0
    CHECK_IDS+=("release")
    plan_add "{\"id\": \"release\", \"title\": \"Release checks\", \"cmd\": $(json_str "$TN_RELEASE"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"after\": $1, \"env\": {$CHECK_ENV}, \"tell\": {\"rc\": 3, \"note\": \"in progress\"}}"
}
run_board() {   # run_board copy|insync|passed|nothing|unreachable — sets RES (the results file)
    local want_copy="$1" after="[]" cmd
    command -v python3 >/dev/null 2>&1 || die "python3 isn't installed: tnsync's board (dev/board.py) needs it"
    [ -f "$BOARD" ] || die "$BOARD isn't there: tnsync's board lives next to tnsync"
    BOARD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/tnsync-board.XXXXXX")"
    RES="$BOARD_DIR/results"
    PLAN=""; CHECK_IDS=()
    if [ "$want_copy" = "passed" ]; then
        # (each block's line: when it passed, then its result line from then — what it ran on, what it found)
        # ("Passed 4 minutes ago (2026-11-03 13:51)"; a result kept before tnsync kept its time in seconds: "Passed 2026-11-03 13:51")
        local when at; when="$(state_get when)"; at="$(state_get at)"
        case "$at" in ''|*[!0-9]*) ;; *) when="$(ago "$at") ($when)" ;; esac
        was() { local l; l="$(state_get "last_$1")"; printf '%s' "Passed $when${l:+ · $l}"; }
        passed_section current "Current Tests" "$TN_TEST" "$(was current)"
        [ -z "$FUTURE_CMD" ] || [ "$(state_get future)" != pass ] || passed_section future "Future Tests" "$FUTURE_CMD" "$(was future)"
        passed_section validate "HTML/JS/CSS Validation" "$TN_VALIDATE" "$(was validate)"
        passed_section types "Python Validation" "$TN_TYPES" "$(was types)"
        passed_section build "Build Validation" "$TN_BUILD" "$(was build)"
        coverage_section "[]"   # (from the coverage the tests that passed saved: quick, and it says what's still to add)
        audit_section
        i18n_section
        release_section "[]"   # (readiness moves between runs of the same code only by what git keeps, so it's run again)
    elif [ "$SKIP_TESTS" != 1 ] && [ "$want_copy" != "nothing" ]; then
        check_section current "Current Tests" "$TN_TEST"
        [ -n "$TN_TEST" ] || told_section current "Current Tests" "not set up" "No TN_TEST in .tnsync, so no tests were run."
        [ -z "$FUTURE_CMD" ] || check_section future "Future Tests" "$FUTURE_CMD" "\"stop_with\": [\"current\"], \"not_run_rc\": 3"
        [ -n "$FUTURE_CMD" ] || [ -z "$TN_FUTURE" ] || told_section future "Future Tests" "skipped" "TN_FUTURE wasn't run: tnsync $MODE --skip-future."
        check_section validate "HTML/JS/CSS Validation" "$TN_VALIDATE"
        check_section types "Python Validation" "$TN_TYPES"
        check_section build "Build Validation" "$TN_BUILD"
        audit_section
        [ "$RELEASE" != 1 ] || [ -n "$TN_RELEASE" ] || told_section release "Release checks" "not set up" "No TN_RELEASE in .tnsync, so no release checks were run."
        [ -z "$TN_TEST" ] || coverage_section "[\"current\"]"
        i18n_section
        # (after the tests when they run: they save the coverage its readiness reads)
        if [ -n "$TN_TEST" ]; then release_section "[\"current\"]"; else release_section "[]"; fi
    elif [ "$SKIP_TESTS" = 1 ]; then
        told_section checks "Tests and checks" "skipped" "None of TN_TEST, TN_VALIDATE, TN_TYPES, TN_BUILD, TN_COVERAGE, TN_AUDIT or TN_FUTURE was run (--skip-tests)."
    fi
    local checks="[]"
    [ "${#CHECK_IDS[@]}" = 0 ] || checks="$(json_ids "${CHECK_IDS[@]}")"
    if [ "$want_copy" = "copy" ]; then   # (first on the board: the copy, then the checks)
        local checks_plan="$PLAN"
        [ "$TESTS_FIRST" != 1 ] || after="$checks"
        cmd="$(printf '%q ' "$SELF" "${ORIG_ARGS[@]}")"
        PLAN=""
        plan_add "{\"id\": \"sync\", \"title\": $(json_str "Sync to $TN_HOST"), \"cmd\": $(json_str "$cmd"), \"cwd\": $(json_str "$ROOT"), \"after\": $after, \"doing\": \"copying\", \"env\": {\"TNSYNC_STEP\": \"sync\", \"TNSYNC_SRC\": $(json_str "$SRC"), \"TNSYNC_TOTAL\": \"$(printf '%s\n' "$CHANGES" | grep -c . || true)\"}}"
        [ -z "$checks_plan" ] || plan_add "$checks_plan"
    elif [ -n "$TOLD_SYNC" ]; then
        local checks_plan="$PLAN"
        PLAN=""
        plan_add "$TOLD_SYNC"
        [ -z "$checks_plan" ] || plan_add "$checks_plan"
    fi
    if [ -n "$TN_UPKEEP" ]; then
        # (in your folder, where its pins move; its CVEs are of the copy being checked: TNSYNC_COPY, dev/cves.py)
        plan_add "{\"id\": \"upkeep\", \"title\": \"Dependencies\", \"cmd\": $(json_str "export TNSYNC_UPKEEP=look; $TN_UPKEEP"), \"cwd\": $(json_str "$ROOT"), \"env\": {$CHECK_ENV, \"TNSYNC_COPY\": $(json_str "$SRC")}, \"upkeep\": true, \"then\": {\"cmd\": $(json_str "export TNSYNC_UPKEEP=move; $TN_UPKEEP"), \"after\": $checks}}"
    fi
    # the looks to approve, the last block: every time (it's quick, and approving them changes no code tested), on their own — not a
    # check the copy waits for, nor one whose warning fails the run
    if [ -n "$TN_STYLE" ] && [ "$SKIP_TESTS" != 1 ] && [ "$want_copy" != "nothing" ]; then
        # r, once it says looks are waiting and while the board runs: their review page (TN_STYLE's "check" made
        # "review --board"), in your folder, where approving them writes the guide; it stays open after the board.
        # Once the board is done, its line says the command instead
        local key=""
        if [ -t 0 ] && [[ "$TN_STYLE" == *" check" ]]; then
            key=", \"key\": {\"key\": \"r\", \"cmd\": $(json_str "${TN_STYLE% check} review --board"), \"cwd\": $(json_str "$ROOT"), \"does\": \"Review Style Changes\", \"opens\": \"the review page\", \"line\": \"press r to review them\"}"
        fi
        # and, once it says looks wait, their sample made there and then (TN_STYLE's "check" made "sample"), in your
        # folder, so r opens the page at once; not with --no-sample (r makes it first then)
        local then=", \"env\": {\"TNSYNC_SAMPLE\": \"0\"}"   # (--no-sample: the check as it was, nothing of a sample on it)
        if [ "$NO_SAMPLE" != 1 ] && [[ "$TN_STYLE" == *" check" ]]; then
            then=", \"then\": {\"cmd\": $(json_str "${TN_STYLE% check} sample"), \"cwd\": $(json_str "$ROOT"), \"after\": [], \"doing\": \"looks waiting: making sample\", \"fail_note\": \"looks waiting: no sample\"}"
            # and, once every other block is done (none failed) with looks still waiting, their review there and then,
            # on the board (blue while its page is open; Enter skips it), then the check again: green once all are
            # approved. Not on a dry run.
            if [ "$DRY_RUN" != 1 ]; then
                then="$then, \"finale\": {\"cmd\": $(json_str "${TN_STYLE% check} review --step"), \"check\": $(json_str "$TN_STYLE"), \"cwd\": $(json_str "$ROOT"), \"env\": {\"TNSYNC_SAMPLE\": \"0\", \"TNSYNC_RECHECK\": \"1\"}, \"doing\": \"in review\", \"checking\": \"checking again\", \"label\": \"looks · review page open\", \"enter\": \"Skip review\", \"pass_note\": \"all approved\"}"
            fi
        fi
        plan_add "{\"id\": \"style\", \"title\": \"Style Approval\", \"cmd\": $(json_str "$TN_STYLE"), \"cwd\": $(json_str "$SRC"), \"stoppable\": true, \"warn\": {\"rc\": 1, \"note\": \"looks waiting\"}$key$then}"
    fi
    # the board's header: what's sent and tested (where it goes is the Sync block's to say), the run's modes, the
    # commit, and how to stop it
    local head="$SRC_LABEL" keys=""
    [ "$RELEASE" != 1 ] || head="$head · Release"
    [ "$TESTS_FIRST" != 1 ] || head="$head · Tests first"
    [ "$DRY_RUN" != 1 ] || head="$head · Dry run"
    [ "$NO_SAMPLE" != 1 ] || [ -z "$TN_STYLE" ] || head="$head · No sample"
    if [ -t 0 ] && [ "${#CHECK_IDS[@]}" != 0 ]; then keys="{\"key\": \"Enter\", \"does\": \"Cancel\"}"; fi
    printf '{"header": [%s], "commit": %s, "keys": [%s], "sections": [%s]}\n' "$(json_str "$head")" "$(json_str "$SRC_COMMIT")" "$keys" "$PLAN" > "$BOARD_DIR/plan.json"
    python3 "$BOARD" "$BOARD_DIR/plan.json" "$RES"
    if [ -n "$TN_UPKEEP" ]; then UPKEEP_OUT="$(res_get upkeep_log)"; fi
}
# What the board leaves: each section said its own result in its own block (and what a failed one printed came under
# the board), so nothing is said again here: the result is kept for next time, and the exit code says how it went.
# finish_board insync|copy — exits: 0 all passed, 1 something failed, 2 Enter stopped the checks.
finish_board() {
    local when="$1" sync="" id current_ok=1
    [ "$when" = "copy" ] && sync="$(res_get sync)"
    # the copy didn't happen (--tests-first, and the checks didn't pass): what the NAS has is what it had, its result too
    if [ "$when" = "copy" ] && [ "$sync" != "pass" ] && [ "$sync" != "fail" ]; then when="before"; fi
    [ "$when" != "unreachable" ] || when="before"   # (nothing reached the NAS: its last result stands)
    if [ "${#CHECK_IDS[@]}" = 0 ]; then   # (--skip-tests, or none set up: their blocks said so)
        [ "$sync" != "fail" ] || return 1
        return 0
    fi
    TESTS_RAN=1
    if [ "$(res_get aborted)" = 1 ]; then
        [ "$when" = "before" ] || [ "$DRY_RUN" = 1 ] || record_tests aborted
        return 2
    fi
    FUTURE_RESULT="none"
    for id in "${CHECK_IDS[@]}"; do
        case "$id" in
            future) case "$(res_get future)" in pass) FUTURE_RESULT="pass" ;; fail) FUTURE_RESULT="fail" ;; esac ;;
            *) case "$(res_get "$id")" in pass|info) ;; *) current_ok=0 ;; esac ;;   # (info: its tool only told, grey)
        esac
    done
    if [ "$current_ok" = 1 ] && [ "$FUTURE_RESULT" != "fail" ]; then
        [ "$when" = "before" ] || [ "$DRY_RUN" = 1 ] || record_tests pass
        [ "$sync" != "fail" ] || return 1
        return 0
    fi
    [ "$when" = "before" ] || [ "$DRY_RUN" = 1 ] || record_tests fail
    return 1
}

# ----------------------------------------------------------------- run
if [ -n "$UNREACHABLE" ]; then
    told_sync "can't connect: nothing copied" 1 \
        "Check: you're online, on the NAS's network; TrueNAS: System > Services > SSH is running; your key is added to $TN_USER" \
        "$(printf '%s' "$UNREACHABLE" | tail -n 1)"
    run_board unreachable
    rc=0; finish_board unreachable || rc=$?
    exit 1
fi
CHANGES="$(pending_changes)" || exit 1
if [ -z "$CHANGES" ]; then
    if [ -z "$TN_TEST$TN_VALIDATE$TN_TYPES$TN_BUILD" ] || [ "$SKIP_TESTS" = 1 ]; then
        told_sync "already in sync" 0 "Nothing copied · $TN_HOST already has these files · $TN_APP not restarted"
        run_board nothing
        exit 0
    fi
    why="$(last_tests_not_passed)"
    if [ -z "$why" ]; then
        told_sync "already in sync" 0 "Nothing copied · $TN_HOST already has these files · $TN_APP not restarted"
        run_board passed
        exit 0
    fi
    told_sync "in sync" 0 "${why%.} · nothing copied · $TN_APP not restarted"
    run_board insync
    rc=0; finish_board insync || rc=$?
    exit "$rc"
fi

run_board copy
rc=0; finish_board copy || rc=$?
exit "$rc"
